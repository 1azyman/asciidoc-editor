{
  "name": "@monoted/asciidoc-editor-core",
  "version": "0.1.0",
  "description": "AsciiDoc parser, serializer and ProseMirror schema for the AsciiDoc editor",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "prosemirror-model": "^1.25.0"
  },
  "devDependencies": {
    "asciidoctor": "^4.0.11",
    "typescript": "^5.9.0",
    "vitest": "^5.0.0",
    "@types/node": "^24.0.0"
  }
}
