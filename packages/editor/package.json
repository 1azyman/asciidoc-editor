{
  "name": "@monoted/asciidoc-editor",
  "version": "0.1.0",
  "description": "Framework-free AsciiDoc WYSIWYG editor built on TipTap core",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/asciidoc-editor.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/asciidoc-editor.js"
    },
    "./iife": "./dist/asciidoc-editor.iife.js",
    "./asciidoc-editor.css": "./dist/asciidoc-editor.css",
    "./styles/*": "./src/styles/*"
  },
  "files": [
    "dist",
    "src/styles"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "echo \"no tests yet\""
  },
  "dependencies": {
    "@monoted/asciidoc-editor-core": "workspace:*",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extensions": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "lucide-static": "^1.42.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^8.2.2"
  }
}
